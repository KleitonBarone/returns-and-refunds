{
  "name": "returns-and-refunds",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "check": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "tsx scripts/environment.ts integration",
    "test:environment": "tsx scripts/verify-environment.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:e2e:environment": "tsx scripts/verify-e2e-environment.ts",
    "browser:install": "tsx scripts/install-browser.ts",
    "demo:run": "tsx scripts/demo.ts run",
    "demo:verify": "tsx scripts/demo.ts verify",
    "demo:reset": "tsx scripts/demo.ts reset",
    "demo:record": "tsx scripts/e2e.ts --record",
    "build": "vite build --config apps/web/vite.config.ts",
    "dev": "tsx scripts/environment.ts dev",
    "dev:down": "tsx scripts/environment.ts stop",
    "env:doctor": "tsx scripts/environment.ts doctor",
    "env:clean": "tsx scripts/environment.ts clean",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "simulator:inspect": "tsx scripts/simulator-control.ts inspect",
    "simulator:control": "tsx scripts/simulator-control.ts control"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@tanstack/react-query": "5.104.5",
    "arktype": "2.2.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
